# Environment variables for Vercel (Project → Settings → Environment Variables).
# Copy this file to .env.local only if you run `vercel dev`; never commit real values.

# Added automatically when you connect "Upstash for Redis" in Vercel → Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# You add this one. Your admin panel password (type Kellen829 on the site).
# Use something long and random.
ADMIN_TOKEN=
